# SQLite database file path (persists across restarts when on durable disk)
SQLITE_PATH=./data/do_short.db

# Public base URL used when building short links in API responses
BASE_URL=http://localhost:8000

# In-memory rate limit for POST /api/v1/links only
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
